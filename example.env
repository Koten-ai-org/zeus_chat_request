# Copy to baseline/.env. That file is gitignored.
# Do not put real passwords or API keys in this file.
ZEUS_URL=http://192.168.0.219:8080
ZEUS_USER_BEER=
ZEUS_PASS_BEER=
ZEUS_USER_TRAVEL=
ZEUS_PASS_TRAVEL=
# Provider name from baseline/README.md. LLM_BASE_URL overrides that row's URL.
# Put this provider's key in LLM_API_KEY. LLM_MODEL is that provider's model id.
LLM_PROVIDER=xai
LLM_MODEL=grok-4.7
LLM_API_KEY=
# LLM_BASE_URL=
# Optional script ceilings. Unset uses the code column in baseline/README.md.
# These values are used as written. Set them below the provider console.
# 0 blocks that dimension. Do not use 0 to mean unlimited.
# LLM_TPM=
# LLM_RPM=
# LLM_RPS=
# LLM_REQUEST_TOKENS=
